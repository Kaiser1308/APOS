diff --git a/tests/acceptance/test_sensor.py b/tests/acceptance/test_sensor.py
new file mode 100644
index 0000000..978fafe
--- /dev/null
+++ b/tests/acceptance/test_sensor.py
@@ -0,0 +1,20 @@
+from parking.sensor import on_sensor
+
+
+def test_ac1_a_free_slot_becomes_occupied_when_the_sensor_reports_a_car():
+    lot = {"A1": "free"}
+    on_sensor(lot, "A1", True)
+    assert lot["A1"] == "occupied"
+
+
+def test_ac1_a_second_reading_of_the_same_car_keeps_the_slot_occupied():
+    lot = {"A1": "free"}
+    on_sensor(lot, "A1", True)
+    on_sensor(lot, "A1", True)
+    assert lot["A1"] == "occupied"
+
+
+def test_ac2_a_reserved_slot_becomes_occupied_when_the_booked_car_arrives():
+    lot = {"A1": "reserved"}
+    on_sensor(lot, "A1", True)
+    assert lot["A1"] == "occupied"
