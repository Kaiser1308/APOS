+import pytest
+
+import shop.cart
+from shop.cart import total
+
+
+def test_total_no_longer_takes_a_coupon():
+    with pytest.raises(TypeError):
+        total([("pen", 1000, 1)], coupon="TEN")
+
+
+def test_the_cart_no_longer_knows_how_to_apply_one():
+    assert not hasattr(shop.cart, "apply_coupon")
