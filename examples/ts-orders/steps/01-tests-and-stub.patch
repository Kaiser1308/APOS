@@ -0,0 +1,24 @@
+import { expect, it } from 'vitest';
+import { cancelOrder } from './cancel.ts';
+
+const day = 24 * 60 * 60 * 1000;
+const now = new Date('2026-04-01T12:00:00Z');
+const placedDaysAgo = (days: number) => ({
+  id: 'O-1',
+  placedAt: new Date(now.getTime() - days * day).toISOString(),
+  status: 'open' as const,
+});
+
+it('AC-1: an order placed 31 days ago is refused and stays open', () => {
+  const order = placedDaysAgo(31);
+  expect(() => cancelOrder(order, now)).toThrow('more than 30 days');
+  expect(order.status).toBe('open');
+});
+
+it('AC-2: an order placed exactly 30 days ago can still be cancelled', () => {
+  expect(cancelOrder(placedDaysAgo(30), now).status).toBe('cancelled');
+});
+
+it('AC-2: an order placed 5 days ago is cancelled', () => {
+  expect(cancelOrder(placedDaysAgo(5), now).status).toBe('cancelled');
+});
